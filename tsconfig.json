{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "dist",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noEmitOnError": true,
    "inlineSources": true,
    "noUnusedLocals": true
  },
  "include": [
    "src/**/*.ts",
    "bin/**/*.ts",
    "demo/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "examples/playwright/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
