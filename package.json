{
  "name": "lintapple",
  "version": "0.1.15",
  "description": "Check rendered interfaces against explicit design rules.",
  "type": "module",
  "bin": {
    "lintapple": "./bin/lintapple.js",
    "ui-lint": "./bin/lintapple.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./playwright": {
      "types": "./src/playwright.d.ts",
      "default": "./src/playwright.js"
    }
  },
  "files": [
    "bin",
    "src",
    "ui-policy.json",
    "examples",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node bin/lintapple.js",
    "demo": "node demo/server.js",
    "demo:check": "node --test test/demo.test.js",
    "release:build": "node scripts/build-release.mjs",
    "test:playwright": "playwright test --config examples/playwright/playwright.config.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "axe-core": "4.14.0",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "lenis": "1.3.26"
  }
}
