{
  "name": "lintapple",
  "version": "0.1.23",
  "description": "Check rendered interfaces against explicit design rules.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lintapple": "./dist/bin/lintapple.js",
    "ui-lint": "./dist/bin/lintapple.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./playwright": {
      "types": "./dist/src/playwright.d.ts",
      "default": "./dist/src/playwright.js"
    }
  },
  "files": [
    "dist/src",
    "dist/bin",
    "dist/ui-policy.json",
    "ui-policy.json",
    "examples",
    "README.md"
  ],
  "scripts": {
    "test": "npm run build && node --test --test-concurrency=2 dist/test/*.test.js",
    "check": "npm run build && node dist/bin/lintapple.js",
    "demo": "npm run build && node dist/demo/server.js",
    "demo:check": "npm run build && node --test dist/test/demo.test.js",
    "release:build": "npm run build && node dist/scripts/build-release.js",
    "test:playwright": "npm run build && playwright test --config dist/examples/playwright/playwright.config.js",
    "demo:highlight": "npm run build && node dist/scripts/highlight-demo.js",
    "build": "tsc && node dist/scripts/build-assets.js",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "axe-core": "4.14.0",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "lenis": "1.3.26",
    "shiki": "4.5.0",
    "typescript": "^5.9.3"
  },
  "types": "./dist/src/index.d.ts"
}
